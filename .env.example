POSTGRES_DB=industry_platform
POSTGRES_USER=industry_platform
POSTGRES_PASSWORD=local-postgres-password

REDIS_PASSWORD=local-redis-password

# Redis database 0 remains available for application caches/rate limits.
# Celery uses a separate logical database so broker keys cannot collide.
CELERY_BROKER_REDIS_DB=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BROKER_VISIBILITY_TIMEOUT_SECONDS=3600

# PostgreSQL remains the source of truth. These values only control bounded
# claiming, heartbeats, reconciliation, and dispatcher scan sizes.
JOB_DEFAULT_QUEUE=default
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_UNSTARTED_TIMEOUT_SECONDS=300
JOB_DEFAULT_SOFT_TIME_LIMIT_SECONDS=1500
JOB_DEFAULT_HARD_TIME_LIMIT_SECONDS=1800
JOB_DISPATCH_BATCH_SIZE=100
JOB_RECONCILE_BATCH_SIZE=100
OUTBOX_CLAIM_SECONDS=60
OUTBOX_DISPATCH_BATCH_SIZE=100
SCHEDULER_SCAN_INTERVAL_SECONDS=15

# Optional Direct Answer model configuration. Leave all three values absent to
# produce an explicit provider_not_configured Run failure. When enabling it,
# replace every placeholder and use the Provider's current official token prices.
# AGENT_MODEL_PROVIDER_BASE_URL=https://api.example.com/v1
# AGENT_MODEL_PROVIDER_API_KEY=replace-with-real-provider-key
# AGENT_MODEL_ROUTE_JSON='{"model":"openai-compatible/replace-model","upstream_model":"replace-model","response_models":["replace-model"],"pricing_version":"replace-pricing-v1","input_micro_usd_per_million":<INPUT_RATE>,"cached_input_micro_usd_per_million":<CACHED_INPUT_RATE>,"output_micro_usd_per_million":<OUTPUT_RATE>}'
AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=30

# Generate each value independently with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Each value must be unpadded base64url for 32 random bytes. Never reuse a value.
REFRESH_TOKEN_HMAC_KEY_B64=replace-with-independent-base64url-key
CSRF_TOKEN_HMAC_KEY_B64=replace-with-independent-base64url-key
DEVICE_TOKEN_HMAC_KEY_B64=replace-with-independent-base64url-key
LOGIN_RATE_LIMIT_HMAC_KEY_B64=replace-with-independent-base64url-key
REFRESH_RECOVERY_AEAD_KEY_B64=replace-with-independent-base64url-key

# Exact HTTPS origins allowed to perform browser credential mutations.
BROWSER_TRUSTED_ORIGINS_JSON='["https://localhost:5173","https://localhost:4173"]'

# Generate one Ed25519 keypair locally. The private value is a 32-byte raw seed,
# the public ring is JSON mapping a rotation-safe key ID to a 32-byte public key.
# Never reuse any HMAC value above and never commit a real private key.
ACCESS_TOKEN_CURRENT_KID=replace-with-local-key-id
ACCESS_TOKEN_PRIVATE_KEY_B64=replace-with-ed25519-private-seed
ACCESS_TOKEN_PUBLIC_KEYS_JSON='{"replace-with-local-key-id":"replace-with-ed25519-public-key"}'

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=local-pgadmin-password

APP_ENVIRONMENT=development
HEALTH_CHECK_TIMEOUT_SECONDS=1.0
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_SALT_LENGTH=16
ARGON2_HASH_LENGTH=32
ARGON2_MAX_CONCURRENCY=2
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_ACCOUNT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=300

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

REDIS_HOST=127.0.0.1
REDIS_PORT=16379
