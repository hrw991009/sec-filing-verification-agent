{
  "$defs": {
    "ActionArgumentConstraint": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Action",
          "type": "string"
        },
        "allowed_values": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Values",
          "type": "array"
        },
        "argument": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Argument",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": ["action", "argument", "required"],
      "title": "ActionArgumentConstraint",
      "type": "object"
    },
    "AgentSecurityCase": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/ReleaseBudget"
        },
        "case_id": {
          "pattern": "^agent-security-p[0-9]{2}-[a-z0-9-]+-(en|zh)$",
          "title": "Case Id",
          "type": "string"
        },
        "denied_action": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denied Action"
        },
        "executable_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Executable Evidence Refs",
          "type": "array"
        },
        "external_workspace_id": {
          "format": "uuid",
          "title": "External Workspace Id",
          "type": "string"
        },
        "failure_mode": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Mode"
        },
        "kind": {
          "$ref": "#/$defs/AgentSecurityKind"
        },
        "language": {
          "$ref": "#/$defs/QuestionLanguage"
        },
        "max_attempts": {
          "maximum": 2,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "repetitions": {
          "default": 3,
          "title": "Repetitions",
          "type": "integer"
        },
        "source_pair_id": {
          "title": "Source Pair Id",
          "type": "string"
        },
        "trajectory": {
          "$ref": "#/$defs/ReleaseTrajectoryContract"
        },
        "untrusted_input": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Untrusted Input"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "source_pair_id",
        "language",
        "question",
        "kind",
        "workspace_id",
        "external_workspace_id",
        "max_attempts",
        "budget",
        "trajectory",
        "executable_evidence_refs"
      ],
      "title": "AgentSecurityCase",
      "type": "object"
    },
    "AgentSecurityKind": {
      "enum": ["prompt_injection", "permission_denial", "transient_recovery"],
      "title": "AgentSecurityKind",
      "type": "string"
    },
    "FinalStateExpectation": {
      "additionalProperties": false,
      "properties": {
        "expected_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Value"
        },
        "operator": {
          "pattern": "^(eq|gte|lte|absent)$",
          "title": "Operator",
          "type": "string"
        },
        "path": {
          "pattern": "^[a-z][A-Za-z0-9_.]*$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": ["path", "operator", "expected_value"],
      "title": "FinalStateExpectation",
      "type": "object"
    },
    "MilestoneOrder": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "After",
          "type": "string"
        },
        "before": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Before",
          "type": "string"
        }
      },
      "required": ["before", "after"],
      "title": "MilestoneOrder",
      "type": "object"
    },
    "QuestionLanguage": {
      "enum": ["en", "zh"],
      "title": "QuestionLanguage",
      "type": "string"
    },
    "ReleaseBudget": {
      "additionalProperties": false,
      "properties": {
        "max_cost_micro_usd": {
          "minimum": 0,
          "title": "Max Cost Micro Usd",
          "type": "integer"
        },
        "max_latency_ms": {
          "minimum": 1,
          "title": "Max Latency Ms",
          "type": "integer"
        },
        "max_revisions": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Revisions",
          "type": "integer"
        },
        "max_steps": {
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_tool_calls": {
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_total_tokens": {
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "max_steps",
        "max_tool_calls",
        "max_total_tokens",
        "max_cost_micro_usd",
        "max_latency_ms",
        "max_revisions"
      ],
      "title": "ReleaseBudget",
      "type": "object"
    },
    "ReleaseTrajectoryContract": {
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "argument_constraints": {
          "items": {
            "$ref": "#/$defs/ActionArgumentConstraint"
          },
          "title": "Argument Constraints",
          "type": "array"
        },
        "expected_stop_reason": {
          "$ref": "#/$defs/RunStopReason"
        },
        "final_state": {
          "items": {
            "$ref": "#/$defs/FinalStateExpectation"
          },
          "title": "Final State",
          "type": "array"
        },
        "forbidden_actions": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Actions",
          "type": "array"
        },
        "partial_order": {
          "items": {
            "$ref": "#/$defs/MilestoneOrder"
          },
          "title": "Partial Order",
          "type": "array"
        },
        "required_milestones": {
          "items": {
            "type": "string"
          },
          "title": "Required Milestones",
          "type": "array"
        }
      },
      "required": [
        "required_milestones",
        "allowed_actions",
        "forbidden_actions",
        "argument_constraints",
        "partial_order",
        "final_state",
        "expected_stop_reason"
      ],
      "title": "ReleaseTrajectoryContract",
      "type": "object"
    },
    "RunStopReason": {
      "description": "Stable reason explaining why a run will no longer advance.",
      "enum": [
        "final",
        "cancelled",
        "provider_timeout",
        "provider_rate_limited",
        "provider_error",
        "invalid_provider_response",
        "incomplete_provider_response",
        "max_steps",
        "deadline_exceeded",
        "token_budget_exceeded",
        "cost_budget_exceeded",
        "tool_denied",
        "tool_error",
        "no_progress",
        "approval_required",
        "approval_denied",
        "approval_timed_out",
        "runtime_error"
      ],
      "title": "RunStopReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/AgentSecurityCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "evidence_layer": {
      "title": "Evidence Layer",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "scorer_version": {
      "title": "Scorer Version",
      "type": "string"
    },
    "source_dataset_id": {
      "title": "Source Dataset Id",
      "type": "string"
    },
    "source_dataset_version": {
      "title": "Source Dataset Version",
      "type": "string"
    },
    "source_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "scorer_version",
    "source_dataset_id",
    "source_dataset_version",
    "source_manifest_sha256",
    "evidence_layer",
    "cases",
    "blockers"
  ],
  "title": "AgentSecurityDataset",
  "type": "object"
}
