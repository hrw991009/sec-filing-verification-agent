{
  "$defs": {
    "ActionArgumentConstraint": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Action",
          "type": "string"
        },
        "allowed_values": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Values",
          "type": "array"
        },
        "argument": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Argument",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": ["action", "argument", "required"],
      "title": "ActionArgumentConstraint",
      "type": "object"
    },
    "EvidenceLayer": {
      "enum": ["deterministic_contract", "offline_capability", "live_model"],
      "title": "EvidenceLayer",
      "type": "string"
    },
    "FinalStateExpectation": {
      "additionalProperties": false,
      "properties": {
        "expected_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Value"
        },
        "operator": {
          "pattern": "^(eq|gte|lte|absent)$",
          "title": "Operator",
          "type": "string"
        },
        "path": {
          "pattern": "^[a-z][A-Za-z0-9_.]*$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": ["path", "operator", "expected_value"],
      "title": "FinalStateExpectation",
      "type": "object"
    },
    "MilestoneOrder": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "After",
          "type": "string"
        },
        "before": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Before",
          "type": "string"
        }
      },
      "required": ["before", "after"],
      "title": "MilestoneOrder",
      "type": "object"
    },
    "QuestionLanguage": {
      "enum": ["en", "zh"],
      "title": "QuestionLanguage",
      "type": "string"
    },
    "ReleaseAnswerGold": {
      "additionalProperties": false,
      "properties": {
        "expected_answer_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Answer Key"
        },
        "expected_business_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Business Status"
        },
        "expected_program": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Program"
        },
        "expected_result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Result"
        },
        "rounding_places": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rounding Places"
        },
        "supporting_fact_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Fact Keys",
          "type": "array"
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "title": "ReleaseAnswerGold",
      "type": "object"
    },
    "ReleaseBudget": {
      "additionalProperties": false,
      "properties": {
        "max_cost_micro_usd": {
          "minimum": 0,
          "title": "Max Cost Micro Usd",
          "type": "integer"
        },
        "max_latency_ms": {
          "minimum": 1,
          "title": "Max Latency Ms",
          "type": "integer"
        },
        "max_revisions": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Revisions",
          "type": "integer"
        },
        "max_steps": {
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_tool_calls": {
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_total_tokens": {
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "max_steps",
        "max_tool_calls",
        "max_total_tokens",
        "max_cost_micro_usd",
        "max_latency_ms",
        "max_revisions"
      ],
      "title": "ReleaseBudget",
      "type": "object"
    },
    "ReleaseCaseKind": {
      "enum": ["fixed_context", "sec_temporal", "live_search", "agent_state"],
      "title": "ReleaseCaseKind",
      "type": "string"
    },
    "ReleaseCaseStatus": {
      "enum": ["planned", "executed"],
      "title": "ReleaseCaseStatus",
      "type": "string"
    },
    "ReleaseEvalCase": {
      "additionalProperties": false,
      "properties": {
        "answer_gold": {
          "$ref": "#/$defs/ReleaseAnswerGold"
        },
        "budget": {
          "$ref": "#/$defs/ReleaseBudget"
        },
        "case_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "case_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Case Version",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Dataset Version",
          "type": "string"
        },
        "document_group_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Document Group Id",
          "type": "string"
        },
        "evidence_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseEvidenceBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_layer": {
          "$ref": "#/$defs/EvidenceLayer"
        },
        "gold_allowed_in_model_context": {
          "default": false,
          "title": "Gold Allowed In Model Context",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ReleaseCaseKind"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/ReleaseQuestion"
          },
          "title": "Questions",
          "type": "array"
        },
        "sec_gold": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseSecGold"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Ids",
          "type": "array"
        },
        "split": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Split",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReleaseCaseStatus"
        },
        "strategy_ids": {
          "items": {
            "type": "string"
          },
          "title": "Strategy Ids",
          "type": "array"
        },
        "trajectory": {
          "$ref": "#/$defs/ReleaseTrajectoryContract"
        }
      },
      "required": [
        "case_id",
        "case_version",
        "dataset_id",
        "dataset_version",
        "split",
        "document_group_id",
        "source_artifact_ids",
        "kind",
        "evidence_layer",
        "questions",
        "strategy_ids",
        "budget",
        "trajectory",
        "answer_gold",
        "status"
      ],
      "title": "ReleaseEvalCase",
      "type": "object"
    },
    "ReleaseEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "calculation_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Calculation Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "trace_id": {
          "format": "uuid",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": ["run_id", "trace_id", "evidence_ids", "calculation_ids"],
      "title": "ReleaseEvidenceBinding",
      "type": "object"
    },
    "ReleaseManifestStatus": {
      "enum": ["contract_only", "frozen", "executed"],
      "title": "ReleaseManifestStatus",
      "type": "string"
    },
    "ReleaseQuestion": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/QuestionLanguage"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": ["language", "text"],
      "title": "ReleaseQuestion",
      "type": "object"
    },
    "ReleaseRuntimeConfiguration": {
      "additionalProperties": false,
      "properties": {
        "context_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Context Version",
          "type": "string"
        },
        "graph_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Graph Version",
          "type": "string"
        },
        "harness_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Harness Version",
          "type": "string"
        },
        "model_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Model Name",
          "type": "string"
        },
        "model_provider": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Model Provider",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Model Version",
          "type": "string"
        },
        "prompt_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Prompt Version",
          "type": "string"
        },
        "retrieval_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Retrieval Version",
          "type": "string"
        },
        "runtime_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Runtime Version",
          "type": "string"
        },
        "scorer_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Scorer Version",
          "type": "string"
        },
        "toolset_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Toolset Version",
          "type": "string"
        },
        "verifier_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verifier Version"
        }
      },
      "required": [
        "runtime_version",
        "harness_version",
        "model_provider",
        "model_name",
        "model_version",
        "prompt_version",
        "toolset_version",
        "context_version",
        "retrieval_version",
        "graph_version",
        "scorer_version"
      ],
      "title": "ReleaseRuntimeConfiguration",
      "type": "object"
    },
    "ReleaseSecGold": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "cik": {
          "pattern": "^[0-9]{10}$",
          "title": "Cik",
          "type": "string"
        },
        "report_period": {
          "format": "date",
          "title": "Report Period",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ReleaseSecSource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": ["cik", "report_period", "as_of", "sources"],
      "title": "ReleaseSecGold",
      "type": "object"
    },
    "ReleaseSecSource": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$",
          "title": "Accession",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "evidence_locators": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Locators",
          "type": "array"
        },
        "form": {
          "title": "Form",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": ["accession", "form", "available_at", "snapshot_sha256", "evidence_locators"],
      "title": "ReleaseSecSource",
      "type": "object"
    },
    "ReleaseStrategy": {
      "additionalProperties": false,
      "properties": {
        "available_tools": {
          "items": {
            "type": "string"
          },
          "title": "Available Tools",
          "type": "array"
        },
        "configuration": {
          "$ref": "#/$defs/ReleaseRuntimeConfiguration"
        },
        "strategy_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Strategy Id",
          "type": "string"
        }
      },
      "required": ["strategy_id", "configuration", "available_tools"],
      "title": "ReleaseStrategy",
      "type": "object"
    },
    "ReleaseTrajectoryContract": {
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "argument_constraints": {
          "items": {
            "$ref": "#/$defs/ActionArgumentConstraint"
          },
          "title": "Argument Constraints",
          "type": "array"
        },
        "expected_stop_reason": {
          "$ref": "#/$defs/RunStopReason"
        },
        "final_state": {
          "items": {
            "$ref": "#/$defs/FinalStateExpectation"
          },
          "title": "Final State",
          "type": "array"
        },
        "forbidden_actions": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Actions",
          "type": "array"
        },
        "partial_order": {
          "items": {
            "$ref": "#/$defs/MilestoneOrder"
          },
          "title": "Partial Order",
          "type": "array"
        },
        "required_milestones": {
          "items": {
            "type": "string"
          },
          "title": "Required Milestones",
          "type": "array"
        }
      },
      "required": [
        "required_milestones",
        "allowed_actions",
        "forbidden_actions",
        "argument_constraints",
        "partial_order",
        "final_state",
        "expected_stop_reason"
      ],
      "title": "ReleaseTrajectoryContract",
      "type": "object"
    },
    "RunStopReason": {
      "description": "Stable reason explaining why a run will no longer advance.",
      "enum": [
        "final",
        "cancelled",
        "provider_timeout",
        "provider_rate_limited",
        "provider_error",
        "invalid_provider_response",
        "incomplete_provider_response",
        "max_steps",
        "deadline_exceeded",
        "token_budget_exceeded",
        "cost_budget_exceeded",
        "tool_denied",
        "tool_error",
        "no_progress",
        "approval_required",
        "approval_denied",
        "approval_timed_out",
        "runtime_error"
      ],
      "title": "RunStopReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/ReleaseEvalCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "manifest_id": {
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_version": {
      "title": "Manifest Version",
      "type": "string"
    },
    "registry_id": {
      "title": "Registry Id",
      "type": "string"
    },
    "registry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Registry Sha256",
      "type": "string"
    },
    "registry_version": {
      "title": "Registry Version",
      "type": "string"
    },
    "release_ready": {
      "title": "Release Ready",
      "type": "boolean"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ReleaseManifestStatus"
    },
    "strategies": {
      "items": {
        "$ref": "#/$defs/ReleaseStrategy"
      },
      "title": "Strategies",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "registry_id",
    "registry_version",
    "registry_sha256",
    "status",
    "strategies",
    "cases",
    "release_ready",
    "blockers"
  ],
  "title": "ReleaseEvalManifest",
  "type": "object"
}
