          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/SecTemporalCategory"
        },
        "gold_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Gold Id",
          "type": "string"
        },
        "human_review_required": {
          "default": true,
          "title": "Human Review Required",
          "type": "boolean"
        },
        "pair_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Pair Id",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/ReleaseQuestion"
          },
          "title": "Questions",
          "type": "array"
        },
        "scenario_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "split": {
          "$ref": "#/$defs/SecTemporalSplit"
        },
        "trajectory_profile_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Trajectory Profile Id",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "split",
        "category",
        "questions",
        "gold_id",
        "budget_profile_id",
        "trajectory_profile_id"
      ],
      "title": "SecTemporalPair",
      "type": "object"
    },
    "SecTemporalPeriod": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "instant": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instant"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        }
      },
      "title": "SecTemporalPeriod",
      "type": "object"
    },
    "SecTemporalScenario": {
      "additionalProperties": false,
      "properties": {
        "denied_action": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denied Action"
        },
        "failure_mode": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Mode"
        },
        "kind": {
          "$ref": "#/$defs/SecTemporalScenarioKind"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 2,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "scenario_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "untrusted_payload": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Untrusted Payload"
        }
      },
      "required": ["scenario_id", "kind"],
      "title": "SecTemporalScenario",
      "type": "object"
    },
    "SecTemporalScenarioKind": {
      "enum": ["prompt_injection", "permission_denial", "transient_recovery"],
      "title": "SecTemporalScenarioKind",
      "type": "string"
    },
    "SecTemporalScope": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "cik": {
          "pattern": "^[0-9]{10}$",
          "title": "Cik",
          "type": "string"
        },
        "forbidden_future_source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Forbidden Future Source Ids",
          "type": "array"
        },
        "report_period": {
          "format": "date",
          "title": "Report Period",
          "type": "string"
        },
        "visible_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Visible Source Ids",
          "type": "array"
        }
      },
      "required": ["cik", "report_period", "as_of", "visible_source_ids"],
      "title": "SecTemporalScope",
      "type": "object"
    },
    "SecTemporalSource": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$",
          "title": "Accession",
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/SecTemporalArtifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "cik": {
          "pattern": "^[0-9]{10}$",
          "title": "Cik",
          "type": "string"
        },
        "filed_on": {
          "format": "date",
          "title": "Filed On",
          "type": "string"
        },
        "form": {
          "title": "Form",
          "type": "string"
        },
        "primary_document": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.htm$",
          "title": "Primary Document",
          "type": "string"
        },
        "report_period": {
          "format": "date",
          "title": "Report Period",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/SecTemporalSplit"
        }
      },
      "required": [
        "source_id",
        "split",
        "cik",
        "accession",
        "form",
        "report_period",
        "filed_on",
        "available_at",
        "primary_document",
        "artifacts"
      ],
      "title": "SecTemporalSource",
      "type": "object"
    },
    "SecTemporalSplit": {
      "enum": ["construction", "development", "release_holdout"],
      "title": "SecTemporalSplit",
      "type": "string"
    },
    "SecTemporalTrajectoryProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Profile Id",
